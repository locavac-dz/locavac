# ──────────────────────────────────────────────
# Locavac — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# ──────────────────────────────────────────────

# Serveur
PORT=3000
NODE_ENV=production

# JWT
JWT_SECRET=changez_ce_secret_par_une_valeur_aleatoire_longue

# Base de données PostgreSQL
DATABASE_URL=postgresql://locavac:mot_de_passe@localhost:5432/locavac

# Email (optionnel — silencieux si absent)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@locavac.dz
EMAIL_PASS=mot_de_passe_smtp
EMAIL_FROM=Locavac <noreply@locavac.dz>
