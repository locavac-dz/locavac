# ──────────────────────────────────────────────
# Locavac — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# ──────────────────────────────────────────────

# Serveur
PORT=3000
NODE_ENV=production

# JWT
JWT_SECRET=changez_ce_secret_par_une_valeur_aleatoire_longue
JWT_EXPIRES_IN=7d

# Base de données PostgreSQL
DATABASE_URL=postgresql://locavac:mot_de_passe@localhost:5432/locavac
# Activer SSL PostgreSQL en production (false par défaut)
DATABASE_SSL=false
# Rejeter les certificats auto-signés (true recommandé en production)
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Email (optionnel — silencieux si absent)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@locavac.dz
EMAIL_PASS=mot_de_passe_smtp
EMAIL_FROM=Locavac <noreply@locavac.dz>

# Paiement BaridiMob — activer uniquement en production après certification Algérie Poste
BARIDIMOB_ENABLED=false

# URL publique de l'application (utilisée pour les redirections OAuth et les emails)
APP_URL=http://localhost:3000

# Google OAuth 2.0 (optionnel — laisser vide pour désactiver le bouton Google)
# Créer les identifiants sur https://console.cloud.google.com/apis/credentials
# Ajouter http://localhost:3000/api/auth/google/callback dans "URI de redirection autorisés"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
